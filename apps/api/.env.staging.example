# ─────────────────────────────────────────────────────────────────────────────
# Agency API — Staging environment variables
#
# Usage: copy to .env.staging, fill in values, configure in Railway staging service.
# NEVER commit .env.staging or any file with real values.
# Staging and production MUST use separate Supabase projects (different SUPABASE_URL).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase staging (Supabase branch "staging" or separate project) ──────────
# Obtain from: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://<staging-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<staging-service-role-key>

# JWT secret for validating client_viewer sessions (Supabase Auth JWTs).
# Found in: Supabase dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=<staging-jwt-secret>

# Anon key (public, read-only). Used by frontend Supabase client.
SUPABASE_ANON_KEY=<staging-anon-key>


# ── Agency API v1 service tokens ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Use DIFFERENT values from production tokens.
AGENCY_API_ADMIN_KEY=
AGENCY_API_HERMES_KEY=
AGENCY_API_PLATFORM_KEY=
# AGENCY_API_CLIENT_KEY is DEPRECATED — do not configure. client_viewer uses Supabase JWT.


# ── Credentials encryption ────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use a DIFFERENT key from production — staging data is not real data.
CREDENTIALS_KEY=


# ── Agency OS ingest ──────────────────────────────────────────────────────────
# Bearer token Hermes uses to POST report contracts.
AGENCY_OS_INGEST_KEY=


# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6


# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to the Vercel preview URL for the staging frontend.
# Multiple origins: CORS_ORIGINS=https://staging.vercel.app,http://localhost:3000
CORS_ORIGINS=https://<staging-vercel-preview>.vercel.app,http://localhost:3000


# ── App ───────────────────────────────────────────────────────────────────────
APP_VERSION=staging
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000


# ── Email (optional for staging — use a test address) ────────────────────────
RESEND_API_KEY=
RESEND_FROM=staging-relatorios@norolabs.com


# ── Meta / Google credentials ─────────────────────────────────────────────────
# For staging, use test accounts or leave empty if not testing ad integrations.
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_MANAGER_ID=


# ── 1Password Connect (SecretRef provider — Etapa 5) ─────────────────────────
# Deploy 1Password Connect: https://developer.1password.com/docs/connect
# OP_CONNECT_TOKEN is a service account token — server-side only, never client-side.
OP_CONNECT_URL=
OP_CONNECT_TOKEN=


# ── Isolation test helpers (local use only, never deployed) ──────────────────
# Used by tests/test_staging_isolation.py. Set locally; never commit values.
SUPABASE_URL_STAGING=https://<staging-project-ref>.supabase.co
SUPABASE_SERVICE_KEY_STAGING=
STAGING_API_URL=https://<staging-railway-url>.up.railway.app
STAGING_ADMIN_KEY=
PROD_API_URL=https://<prod-railway-url>.up.railway.app
PROD_ADMIN_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Railway staging configuration notes:
#
# 1. Create a new Railway service in the same project (or a separate staging project).
# 2. Point it to the same repo but configure a staging environment.
# 3. Set all env vars above in the Railway staging service settings.
# 4. Override the Supabase branch URL (SUPABASE_URL) to point at the staging branch.
# 5. The staging API should be accessible at a separate URL from production
#    (e.g. https://noro-api-staging.up.railway.app).
# 6. Vercel preview deployments auto-inherit NEXT_PUBLIC_* vars from preview env.
#    Set NEXT_PUBLIC_API_URL in Vercel to point at the staging Railway URL.
# ─────────────────────────────────────────────────────────────────────────────
